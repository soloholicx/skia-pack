# skia-pack canonical GN args — iOS arm64 (simulator), official static build.
# One arg per line. Lines starting with '#' are comments; scripts/build.sh
# strips them and joins the rest into the --args string.
#
# Derived from gn/macos.gn: every arg below the marker is a macOS line
# verbatim (scripts/verify.sh fails if the two drift; see gn/macos.gn for what
# each one is for), followed by the iOS differences:
#   * target_os="ios", ios_use_simulator=true
#   * ios_min_target="17.0"          — the deployment target. Unlike macOS
#     (where Skia hardcodes -target arm64-apple-macos11), Skia's iOS toolchain
#     honours it: every object carries LC_BUILD_VERSION minos 17.0, which
#     scripts/verify.sh asserts on the release bytes.
#   * skia_ios_use_signing=false     — static archives only; nothing to sign.
#   * skia_use_gl=false              — macOS has it on because rust-skia's
#     desktop consumers need it; no iOS consumer uses OpenGL ES, and it would
#     add a dependency on a deprecated framework.
#   * extra_cflags carries -O3 and the HarfBuzz include (no
#     -mmacosx-version-min).
# Known quirk: for target_cpu="arm64" Skia's gn/skia/BUILD.gn passes BOTH
# -arch arm64 and -arch arm64e, so the archives come out fat (arm64 + arm64e).
# scripts/package.sh thins every archive to arm64 before merging; arm64e is
# not shipped.
# --- shared with gn/macos.gn (verbatim) ---
is_skia_standalone=false
is_official_build=true
skia_use_partition_alloc=false
is_debug=false
skia_enable_svg=false
skia_enable_ganesh=true
skia_enable_graphite=false
skia_enable_skottie=false
skia_enable_pdf=true
skia_use_egl=false
skia_use_x11=false
skia_use_system_libpng=false
skia_use_system_zlib=false
skia_use_xps=false
skia_use_libjpeg_turbo_decode=true
skia_use_libjpeg_turbo_encode=true
cc="clang"
cxx="clang++"
skia_use_metal=true
skia_enable_skshaper=true
skia_use_icu=true
skia_use_system_icu=false
skia_use_harfbuzz=true
skia_pdf_subset_harfbuzz=true
skia_enable_skparagraph=true
skia_use_freetype=false
skia_use_system_libjpeg_turbo=false
skia_use_expat=true
skia_use_system_expat=false
target_cpu="arm64"
skia_use_system_harfbuzz=true
skia_use_system_libwebp=false
skia_use_dng_sdk=false
skia_use_fontconfig=false
skia_enable_tools=false
is_component_build=false
extra_cflags_cc=["-std=c++20"]
# --- iOS differences ---
target_os="ios"
ios_use_simulator=true
ios_min_target="17.0"
skia_ios_use_signing=false
skia_use_gl=false
extra_cflags=["-O3","-I@HB_INCLUDE@"]
